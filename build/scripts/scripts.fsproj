<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Nullean.Runna.Fs reads the target descriptions from the /// comments in Program.fs -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- explicit: under central package management the SDK adds no FSharp.Core -->
    <PackageReference Include="FSharp.Core" />
    <!-- runna builds itself with the Nullean.Runna.Fs in this repository; Proc.Fs comes with it -->
    <ProjectReference Include="..\..\src\Nullean.Runna.Fs\Nullean.Runna.Fs.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Paths.fs" />
    <Compile Include="Versions.fs" />
    <Compile Include="Documentation.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
