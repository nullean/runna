<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
    <!-- C# 15 unions: RunnaApp<TUnion> takes a union type as the target identity -->
    <LangVersion>latest</LangVersion>
    <MinVerDefaultPreReleaseIdentifiers>canary.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
  </ItemGroup>
  <!-- Expose the artifacts layout to the Argh source generator, which comes with Nullean.Argh.Core. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="ArtifactsPath" />
    <CompilerVisibleProperty Include="UseArtifactsOutput" />
  </ItemGroup>

  <!-- Package metadata, shared by every package under src/; each project adds its Description and PackageTags -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\','/').Contains('/src/'))">
    <Authors>Nullean and contributors</Authors>
    <Copyright>Nullean</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <PackageProjectUrl>https://runna.nullean.net</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/nullean/runna/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/nullean/runna</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    The org icon, the license, the project's README and its agent skills (skills/<name>/SKILL.md) go into every package.
    https://devblogs.microsoft.com/dotnet/delivering-skills-in-nuget-packages/
  -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' And $(MSBuildProjectDirectory.Replace('\','/').Contains('/src/'))">
    <None Include="$(MSBuildThisFileDirectory)nuget-icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\"
          Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
    <None Include="$(MSBuildProjectDirectory)/skills/**/*" Pack="true" PackagePath="skills/" Visible="false" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md') And $(MSBuildProjectDirectory.Replace('\','/').Contains('/src/'))">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
</Project>
