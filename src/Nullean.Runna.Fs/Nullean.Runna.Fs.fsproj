<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Nullean.Runna.Fs</AssemblyName>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Nullean.Runna.Fs</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- FSharp.Core comes from Directory.Packages.props like every other package. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>

    <!-- Nullean.Runna grants InternalsVisibleTo to this assembly by public key. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\build\keys\keypair.snk</AssemblyOriginatorKeyFile>

    <PackageId>Runna.Fs</PackageId>
    <Title>Runna.Fs - F# DU-based build target DSL</Title>
    <Description>F# DU/match binding over Nullean.Runna — exhaustive, typed, namespaced build targets.</Description>
    <PackageTags>build;make;targets;build-automation;fsharp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nullean.Runna\Nullean.Runna.csproj" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Proc.Fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Builders.fs" />
    <Compile Include="FsDtoBinder.fs" />
    <Compile Include="FsGraphBuilder.fs" />
    <Compile Include="RunnaApp.fs" />
  </ItemGroup>

</Project>
